{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "exportedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string"
        }
      },
      "required": ["id", "name"]
    },
    "version": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "number": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "entryPage": {
          "type": "string"
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "title": {
                "type": ["string", "null"]
              }
            },
            "required": ["path", "title"]
          }
        }
      },
      "required": ["id", "number", "entryPage", "pages"]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "const": "Annotation"
          },
          "motivation": {
            "type": "string",
            "const": "commenting"
          },
          "created": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "creator": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "Person"
              },
              "name": {
                "type": "string"
              }
            },
            "required": ["type", "name"]
          },
          "target": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "selector": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "FragmentSelector"
                    },
                    "conformsTo": {
                      "type": "string",
                      "const": "http://www.w3.org/TR/media-frags/"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": ["type", "conformsTo", "value"]
                }
              }
            },
            "required": ["source", "selector"]
          },
          "body": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "TextualBody"
                },
                "value": {
                  "type": "string"
                },
                "format": {
                  "type": "string",
                  "const": "text/plain"
                },
                "creator": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "Person"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": ["type", "name"]
                },
                "created": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              },
              "required": ["type", "value", "format", "creator", "created"]
            }
          },
          "x-hpe:threadId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "x-hpe:number": {
            "type": ["integer", "null"],
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "x-hpe:status": {
            "type": "string",
            "enum": ["open", "resolved"]
          },
          "x-hpe:breakpoint": {
            "type": "object",
            "properties": {
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              }
            },
            "required": ["width", "height"]
          },
          "x-hpe:createdBy": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "user"
                  },
                  "userId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 120
                  }
                },
                "required": ["kind", "userId", "name"]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "guest"
                  },
                  "guestId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 120
                  }
                },
                "required": ["kind", "guestId", "name"]
              }
            ]
          },
          "x-hpe:comments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "threadId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "author": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "user"
                        },
                        "userId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "name": {
                          "type": "string",
                          "maxLength": 120
                        }
                      },
                      "required": ["kind", "userId", "name"]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "guest"
                        },
                        "guestId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "name": {
                          "type": "string",
                          "maxLength": 120
                        }
                      },
                      "required": ["kind", "guestId", "name"]
                    }
                  ]
                },
                "body": {
                  "type": "string",
                  "maxLength": 5000
                },
                "createdAt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "editedAt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              },
              "required": ["id", "threadId", "author", "body", "createdAt"]
            }
          },
          "x-hpe:resolvedAt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "x-hpe:markup": {
            "type": "object",
            "properties": {
              "pageId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "viewport": {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "integer",
                    "minimum": 200,
                    "maximum": 4000
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 200,
                    "maximum": 4000
                  }
                },
                "required": ["width", "height"]
              },
              "shape": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "rect"
                      },
                      "x": {
                        "type": "number",
                        "minimum": -100000,
                        "maximum": 100000
                      },
                      "y": {
                        "type": "number",
                        "minimum": -100000,
                        "maximum": 100000
                      },
                      "w": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 100000
                      },
                      "h": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 100000
                      },
                      "color": {
                        "type": "string",
                        "enum": ["#e5484d", "#f76b15", "#ffb224", "#30a46c", "#0091ff", "#24211c"]
                      },
                      "stroke": {
                        "type": "number",
                        "enum": [2, 4, 8]
                      }
                    },
                    "required": ["kind", "x", "y", "w", "h", "color", "stroke"]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "arrow"
                      },
                      "from": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "number",
                            "minimum": -100000,
                            "maximum": 100000
                          },
                          "y": {
                            "type": "number",
                            "minimum": -100000,
                            "maximum": 100000
                          }
                        },
                        "required": ["x", "y"]
                      },
                      "to": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "number",
                            "minimum": -100000,
                            "maximum": 100000
                          },
                          "y": {
                            "type": "number",
                            "minimum": -100000,
                            "maximum": 100000
                          }
                        },
                        "required": ["x", "y"]
                      },
                      "color": {
                        "type": "string",
                        "enum": ["#e5484d", "#f76b15", "#ffb224", "#30a46c", "#0091ff", "#24211c"]
                      },
                      "stroke": {
                        "type": "number",
                        "enum": [2, 4, 8]
                      }
                    },
                    "required": ["kind", "from", "to", "color", "stroke"]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "pen"
                      },
                      "points": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2000,
                        "items": {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "number",
                              "minimum": -100000,
                              "maximum": 100000
                            },
                            {
                              "type": "number",
                              "minimum": -100000,
                              "maximum": 100000
                            }
                          ],
                          "minItems": 2,
                          "maxItems": 2
                        }
                      },
                      "color": {
                        "type": "string",
                        "enum": ["#e5484d", "#f76b15", "#ffb224", "#30a46c", "#0091ff", "#24211c"]
                      },
                      "stroke": {
                        "type": "number",
                        "enum": [2, 4, 8]
                      }
                    },
                    "required": ["kind", "points", "color", "stroke"]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "highlighter"
                      },
                      "points": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2000,
                        "items": {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "number",
                              "minimum": -100000,
                              "maximum": 100000
                            },
                            {
                              "type": "number",
                              "minimum": -100000,
                              "maximum": 100000
                            }
                          ],
                          "minItems": 2,
                          "maxItems": 2
                        }
                      },
                      "color": {
                        "type": "string",
                        "enum": ["#e5484d", "#f76b15", "#ffb224", "#30a46c", "#0091ff", "#24211c"]
                      },
                      "stroke": {
                        "type": "number",
                        "enum": [2, 4, 8]
                      }
                    },
                    "required": ["kind", "points", "color", "stroke"]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "text"
                      },
                      "x": {
                        "type": "number",
                        "minimum": -100000,
                        "maximum": 100000
                      },
                      "y": {
                        "type": "number",
                        "minimum": -100000,
                        "maximum": 100000
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "color": {
                        "type": "string",
                        "enum": ["#e5484d", "#f76b15", "#ffb224", "#30a46c", "#0091ff", "#24211c"]
                      },
                      "stroke": {
                        "type": "number",
                        "enum": [2, 4, 8]
                      }
                    },
                    "required": ["kind", "x", "y", "text", "color", "stroke"]
                  }
                ]
              }
            },
            "required": ["pageId", "viewport", "shape"]
          }
        },
        "required": [
          "id",
          "type",
          "motivation",
          "created",
          "creator",
          "target",
          "body",
          "x-hpe:threadId",
          "x-hpe:number",
          "x-hpe:status",
          "x-hpe:breakpoint",
          "x-hpe:markup",
          "x-hpe:createdBy",
          "x-hpe:comments"
        ]
      }
    }
  },
  "required": ["$schema", "schemaVersion", "exportedAt", "project", "version", "items"],
  "$id": "https://hpe.example/schemas/annotations.v2.json",
  "title": "HPE annotations.json v2"
}
