{
  "name": "@hpe/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate && tsx scripts/strip-public-schema.ts",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^10.1.8",
    "@hpe/exporter": "workspace:*",
    "@hpe/shared": "workspace:*",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "htmlparser2": "^12.0.0",
    "mime-types": "^3.0.2",
    "nodemailer": "^10.5.0",
    "parse5": "^8.1.1",
    "pg": "^8.23.1",
    "ulid": "^3.0.2",
    "yauzl": "^3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/yauzl": "^3.4.0",
    "drizzle-kit": "^0.31.11",
    "fflate": "^0.8.3"
  }
}
