# 主應用（受信任 origin）
APP_ORIGIN=http://localhost:5173
# API origin
API_ORIGIN=http://localhost:5175
# prototype 內容網域（獨立的可註冊網域；開發用 *.localhost）。每個版本一個子網域 {contentKey}.CONTENT_BASE_DOMAIN
CONTENT_BASE_DOMAIN=content.localhost:5174
CONTENT_PORT=5174
API_PORT=5175

DATABASE_URL=postgres://localhost:5432/hpe_dev
# fs | s3
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=.data/storage
# STORAGE_DRIVER=s3 時使用
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=hpe
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# session cookie 簽章用（至少 32 字元）
SESSION_SECRET=change-me-change-me-change-me-change
# Google OAuth（Google Cloud Console → OAuth client「Web application」；
# Authorized redirect URI 填 ${API_ORIGIN}/auth/google/callback：
#   本機 http://localhost:5175/auth/google/callback
#   正式（Pages 代理）https://html-prototype-editor.pages.dev/api/auth/google/callback，見 docs/DEPLOYMENT.md）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 開發／e2e 用：POST /auth/dev-login 直接以 email 登入。NODE_ENV=production 禁止開啟
DEV_LOGIN=true

# API ↔ content server 內部通道（兩邊必須相同；正式環境必填）
INTERNAL_TOKEN=dev-internal-token
# content server 呼叫 API 的內部 origin
API_INTERNAL_ORIGIN=http://localhost:5175
