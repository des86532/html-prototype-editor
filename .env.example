# 主應用（受信任 origin）
APP_ORIGIN=http://localhost:5173
# API origin
API_ORIGIN=http://localhost:5175
# prototype 內容網域（獨立的可註冊網域；開發用 *.localhost）。每個版本一個子網域 {contentKey}.CONTENT_BASE_DOMAIN
CONTENT_BASE_DOMAIN=content.localhost:5174
CONTENT_PORT=5174
API_PORT=5175

DATABASE_URL=postgres://localhost:5432/hpe_dev
# fs | s3
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=.data/storage
# STORAGE_DRIVER=s3 時使用
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=hpe
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# session cookie 簽章用（至少 32 字元）
SESSION_SECRET=change-me-change-me-change-me-change
# 啟用開發用 magic link（直接回傳連結，不寄信）。正式環境請設為 false 並設定 SMTP
DEV_MAGIC_LINK=true

# API ↔ content server 內部通道（兩邊必須相同；正式環境必填）
INTERNAL_TOKEN=dev-internal-token
# content server 呼叫 API 的內部 origin
API_INTERNAL_ORIGIN=http://localhost:5175
